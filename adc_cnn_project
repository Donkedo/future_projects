_rng(42)\n","def generate_symbols(modulation, n_symbols):\n","    \"\"\"Generate a fresh random symbol sequence.\"\"\"\n","\n","    bits_per_symbol = {\n","        \"QPSK\": 2,\n","        \"8PSK\": 3,\n","        \"16QAM\": 4,\n","        \"64QAM\": 6\n","    }[modulation]\n","\n","    bits = rng.integers(\n","        0, 2, size=n_symbols * bits_per_symbol\n","    ).reshape(n_symbols, bits_per_symbol)\n","\n","    if modulation == \"QPSK\":\n","        I = 1 - 2 * bits[:, 0]\n","        Q = 1 - 2 * bits[:, 1]\n","        symbols = (I + 1j * Q) / np.sqrt(2)\n","\n","    elif modulation == \"8PSK\":\n","        weights = np.array([4, 2, 1])\n","        k = bits @ weights\n","        phase = 2 * np.pi * k / 8\n","        symbols = np.exp(1j * phase)\n","\n","    elif modulation == \"16QAM\":\n","        weights = np.array([2, 1])\n","        I = 2 * (bits[:, :2] @ weights) - 3\n","        Q = 2 * (bits[:, 2:] @ weights) - 3\n","        symbols = (I + 1j * Q) / np.sqrt(10)\n","\n","    elif modulation == \"64QAM\":\n","        weights = np.array([4, 2, 1])\n","        I = 2 * (bits[:, :3] @ weights) - 7\n","        Q = 2 * (bits[:, 3:] @ weights) - 7\n","        symbols = (I + 1j * Q) / np.sqrt(42)\n","\n","    return symbols\n","\n","\n","def add_awgn(symbols, snr_db):\n","    \"\"\"Add complex Gaussian noise at the requested SNR.\"\"\"\n","\n","    signal_power = np.mean(np.abs(symbols) ** 2)\n","    snr_linear = 10 ** (snr_db / 10)\n","    noise_power = signal_power / snr_linear\n","\n","    noise = np.sqrt(noise_power / 2) * (\n","        rng.standard_normal(len(symbols))\n","        + 1j * rng.standard_normal(len(symbols))\n","    )\n","\n","    return symbols + noise\n","\n","\n","def save_constellation(received, filepath):\n","    \"\"\"Save a consistent, label-free constellation image.\"\"\"\n","\n","    fig, ax = plt.subplots(figsize=(2.27, 2.27), dpi=100)\n","\n","    ax.scatter(\n","        received.real,\n","        received.imag,\n","        s=3,\n","     